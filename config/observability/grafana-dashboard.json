{
  "__inputs": [],
  "__requires": [],
  "id": null,
  "uid": "assistant-overview",
  "title": "Assistant — Service Overview",
  "description": "Health, conversation-turn, tool-call, model-call, history-compaction, and capability-gap-report telemetry for the assistant service (see internal/server/metrics.go).",
  "tags": ["assistant", "milo-os"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "handler",
        "type": "query",
        "label": "Route",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(assistant_http_requests_total, handler)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": false,
        "iconColor": "rgba(255, 96, 96, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate",
      "description": "Requests/sec by route, from assistant_http_requests_total.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (handler) (rate(assistant_http_requests_total{handler=~\"$handler\"}[5m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP error rate (4xx / 5xx)",
      "description": "Share of requests returning 4xx or 5xx, from assistant_http_requests_total, by route.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (handler) (rate(assistant_http_requests_total{handler=~\"$handler\",code=~\"5..\"}[5m]))\n/\nsum by (handler) (rate(assistant_http_requests_total{handler=~\"$handler\"}[5m]))",
          "legendFormat": "{{handler}} 5xx",
          "refId": "A"
        },
        {
          "expr": "sum by (handler) (rate(assistant_http_requests_total{handler=~\"$handler\",code=~\"4..\"}[5m]))\n/\nsum by (handler) (rate(assistant_http_requests_total{handler=~\"$handler\"}[5m]))",
          "legendFormat": "{{handler}} 4xx",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "assistant_http_requests_in_flight",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "assistant_http_requests_in_flight", "legendFormat": "in-flight", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP request latency (p50 / p95 / p99)",
      "description": "histogram_quantile over assistant_http_request_duration_seconds by route.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(assistant_http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))", "legendFormat": "p50 {{handler}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(assistant_http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))", "legendFormat": "p95 {{handler}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(assistant_http_request_duration_seconds_bucket{handler=~\"$handler\"}[5m])))", "legendFormat": "p99 {{handler}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Readiness failures",
      "description": "Rate of assistant_readiness_failures_total — a nonzero sustained rate means the readiness probe is reporting not-ready.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "rate(assistant_readiness_failures_total[5m])", "legendFormat": "readiness failures/sec", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Conversation turns",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Turn rate by state",
      "description": "rate(assistant_conversation_turn_duration_seconds_count[5m]) by state.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (state) (rate(assistant_conversation_turn_duration_seconds_count[5m]))", "legendFormat": "{{state}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Turn duration percentiles (p50 / p95 / p99)",
      "description": "histogram_quantile over assistant_conversation_turn_duration_seconds, all states combined.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Turn duration p95 by state",
      "description": "histogram_quantile over assistant_conversation_turn_duration_seconds, split by state (completed/failed/canceled).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, state) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{state}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Failed + canceled turn rate (% of total)",
      "description": "Share of turns that end in failed or canceled state — a rising trend indicates degrading conversation quality even if HTTP-level errors look fine.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(assistant_conversation_turn_duration_seconds_count{state=\"failed\"}[5m]))\n/\nsum(rate(assistant_conversation_turn_duration_seconds_count[5m]))",
          "legendFormat": "failed %",
          "refId": "A"
        },
        {
          "expr": "sum(rate(assistant_conversation_turn_duration_seconds_count{state=\"canceled\"}[5m]))\n/\nsum(rate(assistant_conversation_turn_duration_seconds_count[5m]))",
          "legendFormat": "canceled %",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Tool calls",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tool call rate by tool",
      "description": "rate(assistant_tool_call_total[5m]) by tool — memory, gap-report, provider MCP tools, skills.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (tool) (rate(assistant_tool_call_total[5m]))", "legendFormat": "{{tool}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "Tool error rate by tool (current)",
      "description": "error / (success+error) rate per tool over the last 5m — bar view makes it easy to spot which single tool is misbehaving.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (tool) (rate(assistant_tool_call_total{outcome=\"error\"}[5m]))\n/\nsum by (tool) (rate(assistant_tool_call_total[5m]))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal" }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Tool call breakdown (success vs error, current)",
      "description": "Raw call counts by tool and outcome over the last 5m, for triage.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(assistant_tool_call_total[5m]))",
          "legendFormat": "{{tool}} / {{outcome}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": { "showHeader": true }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Model calls",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Model call latency percentiles (p50 / p95 / p99)",
      "description": "histogram_quantile over assistant_model_call_duration_seconds.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(assistant_model_call_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_model_call_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(assistant_model_call_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Model call error rate",
      "description": "Share of model calls with outcome=error, from assistant_model_call_duration_seconds_count. A rising trend usually points upstream at the model provider.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(assistant_model_call_duration_seconds_count{outcome=\"error\"}[5m]))\n/\nsum(rate(assistant_model_call_duration_seconds_count[5m]))",
          "legendFormat": "error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      }
    },

    {
      "id": 40,
      "type": "row",
      "title": "History compaction",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Compaction rate by outcome",
      "description": "rate(assistant_history_compaction_total[5m]) by outcome (success/failed_open).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 61 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (outcome) (rate(assistant_history_compaction_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Compaction failed-open rate — silent degradation signal",
      "description": "rate(assistant_history_compaction_total{outcome=\"failed_open\"}[5m]). This does NOT fail the turn — it falls back to plain truncation — so nothing else on this dashboard will show a problem. A nonzero sustained rate here means summarization is silently degrading and conversations are losing context without an operator noticing. Treat any sustained nonzero value as worth investigating, see AssistantCompactionFailingOpen alert.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 61 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "rate(assistant_history_compaction_total{outcome=\"failed_open\"}[5m])", "legendFormat": "failed_open/sec", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2 },
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "purple", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 50,
      "type": "row",
      "title": "Capability gap reports",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 69 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Gap report rate by outcome",
      "description": "rate(assistant_gap_report_total[5m]) by outcome. A business-relevant signal: sustained spikes indicate a provider's tooling has a real, active gap that users keep hitting.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 70 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (outcome) (rate(assistant_gap_report_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
