{
  "__inputs": [],
  "__requires": [],
  "id": null,
  "uid": "assistant-product-quality",
  "title": "Assistant — Product & Quality",
  "description": "Conversation and tooling health signals that don't page anyone but matter for product quality: turn duration percentiles, history-compaction rate (including the failed_open silent-degradation signal), tool-call success/error rate by tool, capability-gap-report rate, and span-derived RED metrics for the assistant service (see internal/server/metrics.go). For on-call/incident triage (HTTP rate/error/latency, readiness, turn/model failure rate), see the companion “Assistant — SRE / On-Call” dashboard.",
  "tags": [
    "assistant",
    "milo-os",
    "product",
    "quality"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "refresh": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": false,
        "iconColor": "rgba(255, 96, 96, 1)"
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Conversation turns — duration & quality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Turn duration percentiles (p50 / p95 / p99)",
      "description": "histogram_quantile over assistant_conversation_turn_duration_seconds, all states combined.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Turn duration p95 by state",
      "description": "histogram_quantile over assistant_conversation_turn_duration_seconds, split by state (completed/failed/canceled).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, state) (rate(assistant_conversation_turn_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Tool calls",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tool call rate by tool",
      "description": "rate(assistant_tool_call_total[5m]) by tool — memory, gap-report, provider MCP tools, skills.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(assistant_tool_call_total[5m]))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "Tool error rate by tool (current)",
      "description": "error / (success+error) rate per tool over the last 5m — bar view makes it easy to spot which single tool is misbehaving.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(assistant_tool_call_total{outcome=\"error\"}[5m]))\n/\nsum by (tool) (rate(assistant_tool_call_total[5m]))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Tool call breakdown (success vs error, current)",
      "description": "Raw call counts by tool and outcome over the last 5m, for triage.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(assistant_tool_call_total[5m]))",
          "legendFormat": "{{tool}} / {{outcome}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Model calls — latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Model call latency percentiles (p50 / p95 / p99)",
      "description": "histogram_quantile over assistant_model_call_duration_seconds.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(assistant_model_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_model_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(assistant_model_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "History compaction",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Compaction rate by outcome",
      "description": "rate(assistant_history_compaction_total[5m]) by outcome (success/failed_open).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(assistant_history_compaction_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Compaction failed-open rate — silent degradation signal",
      "description": "rate(assistant_history_compaction_total{outcome=\"failed_open\"}[5m]). This does NOT fail the turn — it falls back to plain truncation — so nothing else on either dashboard will show a problem. A nonzero sustained rate here means summarization is silently degrading and conversations are losing context without an operator noticing. Treat any sustained nonzero value as worth investigating, see AssistantCompactionFailingOpen alert.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rate(assistant_history_compaction_total{outcome=\"failed_open\"}[5m])",
          "legendFormat": "failed_open/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "purple",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "Capability gap reports",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Gap report rate by outcome",
      "description": "rate(assistant_gap_report_total[5m]) by outcome. A business-relevant signal: sustained spikes indicate a provider's tooling has a real, active gap that users keep hitting.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(assistant_gap_report_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 60,
      "type": "row",
      "title": "Span-derived RED metrics (OTel Collector spanmetrics connector)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "collapsed": false
    },
    {
      "id": 61,
      "type": "timeseries",
      "title": "Call rate by span (span_metrics_calls_total)",
      "description": "sum by (span_name) (rate(span_metrics_calls_total{service_name=\"assistant\"}[5m])). Derived purely from trace spans by the OTel Collector's spanmetrics connector — zero extra app-side instrumentation. Confirmed live span names: assistant.http (SERVER), conversation.turn / model.stream / tool.execute (INTERNAL), \"HTTP POST\" (CLIENT, outbound MCP/tool calls).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (span_name, span_kind) (rate(span_metrics_calls_total{service_name=\"assistant\"}[5m]))",
          "legendFormat": "{{span_name}} ({{span_kind}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 62,
      "type": "timeseries",
      "title": "Error rate by span, status_code=STATUS_CODE_ERROR (span_metrics_calls_total)",
      "description": "Spans whose OTel status was recorded as an error, by span name — e.g. a failed tool.execute span shows up here purely from the trace, independent of the app's own assistant_tool_call_total counter. A second, trace-derived confirmation of the same failure signal.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (span_name) (rate(span_metrics_calls_total{service_name=\"assistant\", status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    },
    {
      "id": 63,
      "type": "timeseries",
      "title": "Span duration p50/p95/p99 by span_name (span_metrics_duration_milliseconds)",
      "description": "histogram_quantile over span_metrics_duration_milliseconds_bucket, the spanmetrics connector's duration histogram derived from real span start/end timestamps — an independent latency signal alongside assistant_conversation_turn_duration_seconds / assistant_model_call_duration_seconds, sourced entirely from tracing rather than app-side histograms.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, span_name) (rate(span_metrics_duration_milliseconds_bucket{service_name=\"assistant\"}[5m])))",
          "legendFormat": "p50 {{span_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(span_metrics_duration_milliseconds_bucket{service_name=\"assistant\"}[5m])))",
          "legendFormat": "p95 {{span_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, span_name) (rate(span_metrics_duration_milliseconds_bucket{service_name=\"assistant\"}[5m])))",
          "legendFormat": "p99 {{span_name}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    }
  ]
}
