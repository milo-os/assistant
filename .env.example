# ── Assistant service configuration ────────────────────────────────────
# Copy to .env and adjust. Only AUTH_* has no safe default; everything
# else has a sensible fallback for local development.

# HTTP listener.
PORT=7820
HOST=0.0.0.0
# Public base URL. Used for the agent-card `url` (→ <base>/a2a) and the
# CloudEvents `source`. Defaults to http://localhost:${PORT} when unset.
PUBLIC_BASE_URL=http://localhost:7820
# debug | info | warn | error
LOG_LEVEL=info

# ── AuthN ──────────────────────────────────────────────────────────────
# dev  → static bearer tokens from AUTH_DEV_TOKENS
# oidc → verify JWTs against OIDC_ISSUER's JWKS (aud = OIDC_AUDIENCE)
AUTH_MODE=dev

# Required when AUTH_MODE=dev. Format:
#   token:subject:projectA,projectB;token2:subject2:projectC
# A project grant of '*' grants every project. Entries are ';'-separated;
# the three fields (token, subject, comma-separated projects) are
# ':'-separated. 401 on an unknown token, 403 on a project the token
# does not grant.
AUTH_DEV_TOKENS=dev-token:local-user:demo-project;admin-token:admin:*

# Required when AUTH_MODE=oidc.
# OIDC_ISSUER=https://idp.example.com
# OIDC_AUDIENCE=assistant.miloapis.com
# JWT claim carrying granted project names (array or space/comma string).
# OIDC_PROJECTS_CLAIM=projects

# ── Capability documents (provider capabilities) ───────────────────────
# Path to a JSON file of capability documents (bare array or a List with
# `items`) — the assistant-owned schema describing each provider's MCP
# endpoint, tool allow-list, and knowledge sources. See the README
# "Capability provider API" section. Unset ⇒ no provider knowledge or
# tools are composed.
CAPABILITY_DOCS_FIXTURE=./fixtures/capability-documents.json

# ── Model ──────────────────────────────────────────────────────────────
# anthropic | mock | gateway. Default: anthropic when ANTHROPIC_API_KEY is
# set, else mock. MODEL_MODE=mock forces the scripted mock model (no
# secrets, no network) — see the README "Mock model" caveat.
MODEL_MODE=mock
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# MODEL_MODE=gateway routes model calls through the Envoy AI Gateway
# (OpenAI-compatible endpoint). The service holds NO upstream model
# credential in this mode — the gateway injects it. Consumer attribution
# travels via x-datum-{project,conversation,agent} headers per request.
# GATEWAY_URL=http://localhost:1975        # required in gateway mode
# GATEWAY_MODEL=patch-stub-v1              # model name the gateway routes
# GATEWAY_CA_CERT=/path/to/gateway-ca.pem  # optional: self-signed gateway TLS
# GATEWAY_TLS_INSECURE=false               # optional: skip TLS verify (local only)

# ── Usage metering ─────────────────────────────────────────────────────
# In-cluster usage collector (Vector http_server source). Events POST to
# <USAGE_GATEWAY_URL>/cloudevents. Unset ⇒ emission is a no-op.
# USAGE_GATEWAY_URL=http://usage-collector:8080
# USAGE_GATEWAY_API_KEY=
