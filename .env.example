TASK_X_REMOTE_TASKFILES=1

# Local assistant dev (go run ./cmd/assistant): capability endpoints are
# reached over loopback, which the SSRF guard blocks by default.
CAPABILITY_ALLOW_PRIVATE_NETWORKS=true

# Only when GATEWAY_URL points at a plaintext local gateway (no TLS). Never set
# this against a real deployment.
# ALLOW_INSECURE_CREDENTIAL_FORWARDING=true
